NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
WEB_PORT=5173
DATABASE_URL=postgresql://cias:cias_dev_password@localhost:5432/cias
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173

