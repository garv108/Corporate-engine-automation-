NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
WEB_PORT=5173
DATABASE_URL=postgresql://cias:cias_dev_password@localhost:5432/cias
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173

# Configure all three values together to enable OIDC authentication.
# CIAS accepts RFC 9068-style JWT access tokens with typ=at+jwt.
# OIDC_ISSUER=https://identity-provider.example/issuer
# OIDC_AUDIENCE=cias-api
# OIDC_JWKS_URL=https://identity-provider.example/.well-known/jwks.json
OIDC_TENANT_CLAIM=cias_tenant_id

# Optional, dedicated database role used only by the controlled organization provisioner.
# Do not point this at the API runtime DATABASE_URL.
# CIAS_PROVISIONING_DATABASE_URL=postgresql://cias_provisioner:REPLACE_ME@localhost:5432/cias
# CIAS_PLATFORM_OPERATOR_TOKEN is supplied at command runtime from a secret manager; never commit it.
